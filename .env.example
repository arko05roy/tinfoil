# copy to .env and edit. every value here is the default.
PORT=4000
MAX_SESSIONS=20        # chromes per box (claimed + warm + booting); beyond → 429
POOL_SIZE=5            # warm chromes kept ready; counts toward MAX_SESSIONS
IDLE_MS=300000         # reap a session after 5 min with no requests
MAX_LIFE_MS=1800000    # hard ceiling: 30 min per session
# CHROME=/path/to/chrome-headless-shell   # defaults to Playwright's cache on macOS
